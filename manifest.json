{
  "manifest_version": 3,
  "name": "Flow Automation",
  "version": "1.2.1",
  "description": "Automatización conservadora por lotes en Google Flow: cola persistente, español y descargas numeradas.",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "*://labs.google/*",
    "*://*.labs.google/*",
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.labs.google/fx/tools/flow*",
        "*://*.labs.google/flow*",
        "*://labs.google/fx/tools/flow*",
        "*://labs.google/flow*",
        "https://flow.google.com/*"
      ],
      "js": [
        "logic.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css"
      ],
      "matches": [
        "*://labs.google/*",
        "https://flow.google.com/*"
      ]
    }
  ]
}
